# Create a bot with https://t.me/BotFather. Keep token PRIVATE.
BOT_TOKEN=
# Administrator numeric Telegram IDs (comma separated), use /id in the bot.
ADMIN_IDS=
# Production: use a persistent Railway PostgreSQL database URL.
DATABASE_URL=sqlite+aiosqlite:///./fa_baza.db
# Web dashboard: secure values (required to enable login)
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=
SESSION_SECRET=
CHANNEL_URL=https://t.me/mops_garant
REPORT_URL=https://t.me/mops_garant
GARANT_CHAT_URL=https://t.me/mops_garant
APPEAL_URL=https://t.me/mops_garant
LOG_LEVEL=INFO
# Optional: Telegram public username -> numeric ID (obtain at my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional opt-in payment confirmation timer, minimum 24 characters. NEVER commit actual value.
PAYMENT_CONFIRM_CODE=
